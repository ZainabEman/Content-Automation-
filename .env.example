# Shared defaults
USER_NAME=Your Name

# Company profile used for prompts, headlines and captions.
COMPANY_FILE=brand/services.md
SERVICES_FILE=config/services.json

# Root folder scanned for identity, brand, creative, and product references (not in git).
REFERENCES_DIR=assets/reference

# Brand profile and the tracked reference settings (style tags, primary photos, mask areas).
BRAND_FILE=config/brand.json
REFERENCES_FILE=config/references.json

# Folder for single jobs (images, videos); each job gets YYYY-MM-DD/HHmm_<name>/ (internal files).
OUTPUT_DIR=outputs/_system/jobs

# Module 1: Core and image
# Image provider for non-Roman images: codex_builtin (default: Codex's built-in image
# generation, gpt-image-2; `ca image import`), openrouter (opt-in, paid) or mock (free
# placeholders). Images of Roman are always made by Codex with the Higgsfield plugin
# (Soul 2.0); there is no other route and no fallback.
IMAGE_PROVIDER=codex_builtin

# Image model identifier used by the selected image adapter.
IMAGE_MODEL=openai/gpt-image-2

# OpenRouter images made at once in a build (Higgsfield stays one at a time).
IMAGE_PARALLEL=4

# Maximum number of images generated per day.
IMAGE_DAILY_LIMIT=30

# Maximum image provider request duration in milliseconds.
IMAGE_TIMEOUT_MS=120000

# Extra attempts after a temporary provider error (0 disables retries).
IMAGE_MAX_RETRIES=1

# Identity photos sent per image (1-14, primary photos first).
IMAGE_IDENTITY_REFS_MAX=4

# Size of designed graphics (social_creative): 1K, 2K or 4K. Photos stay 1K.
IMAGE_DESIGN_SIZE=2K

# Who renders headline, points and CTA: auto = the app, only for providers that draw no text
# always = the app; never = the image model. Nano Banana draws its own under auto.
TEXT_OVERLAY=auto

# The person shown in designs with a person (layouts B, C, D, carousel hook) when no --set is given.
DEFAULT_IDENTITY_SET=identity/person_01

# Look, layouts, poses and text rules of designed graphics (colours and fonts: brand.json).
DESIGN_SYSTEM_FILE=config/design_system.json
# Post formats (LinkedIn, Facebook, the static Instagram carousel): zones, fields, prompts.
POST_FORMATS_FILE=config/post_formats.json
# OpenRouter's model for carousel and illustration pictures when IMAGE_PROVIDER=openrouter
# (codex_builtin: config/codex_image.json); IMAGE_PROVIDER=mock keeps them mock.
CAROUSEL_IMAGE_MODEL=openai/gpt-image-2

# OpenRouter API key for IMAGE_PROVIDER=openrouter; keep it only in .env.
OPENROUTER_API_KEY=

# Module 2: Video and voice
# none, mock (placeholder clips) or higgsfield-plugin (Codex makes the clips with its
# Higgsfield plugin); with none or mock a content package keeps its video pending.
VIDEO_PROVIDER=higgsfield-plugin

# Video model or provider model identifier.
VIDEO_MODEL=mock

# Voice provider: none (default; voiceover disabled in the MVP), mock, or elevenlabs.
VOICE_PROVIDER=none

# Voice model: mock, or an ElevenLabs model such as eleven_multilingual_v2.
VOICE_MODEL=mock

# ElevenLabs API key; keep blank until a LIVE task requires it.
ELEVENLABS_API_KEY=

# Optional voice identifier used by the ElevenLabs adapter.
ELEVENLABS_VOICE_ID=

# Maximum wait for an agent step in minutes.
AGENT_STEP_TIMEOUT_MIN=30

# Module 3: Research and content packages
# Scraper: free (default; our own scraper, no account) or mock (offline test articles).
SCRAPER_PROVIDER=free

# Scraper variant; not used by the free or mock scraper.
SCRAPER_MODEL=default

# News sites to collect from (name, url, rssUrl, topics, active).
SOURCES_FILE=config/sources.json

# Root folder for collected research data.
RESEARCH_DIR=research

# Root of the platform tree outputs/<Platform>/<Kind>/... (one folder per content item).
PACKAGES_DIR=outputs

# What can be asked for by name (insta post, facebook ad, reel, ...) and what each one makes.
DELIVERABLES_FILE=config/deliverables.json

# Maximum articles collected from each source per run.
RESEARCH_MAX_ITEMS_PER_SOURCE=25

# Maximum age of articles included in a research run.
RESEARCH_LOOKBACK_DAYS=30

# Module 4: Calendar and Google Drive
# Where finished images, MP4s and the calendar copy go: mock (default; the same folders in
# outputs/drive with fake links) or drive (Google Drive; run `uv run ca drive setup` first).
# Drive is handled by a script, not a plugin: OAuth client JSON in .secrets/ (git-ignored).
STORAGE_PROVIDER=mock

# Emails (comma-separated) that get editor access to the main Drive folder at
# `ca drive setup`, e.g. the social media manager. Blank = private. No public links are made.
DRIVE_SHARE_WITH=
